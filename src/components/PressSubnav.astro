---
const sections = [
  { id: "factsheet", label: "Factsheet" },
  { id: "overview", label: "Overview" },
  { id: "key-features", label: "Key Features" },
  { id: "quick-facts", label: "Quick Facts" },
  { id: "visuals", label: "Visuals" },
  { id: "contact", label: "Contact" },
];
---

<nav class="press-subnav" id="press-subnav">
  <div class="press-subnav__inner">
    {
      sections.map(({ id, label }) => (
        <a href={`#${id}`} class="press-subnav__tab">
          {label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  /* Sits right below the main nav in normal flow, hidden until 50%
     through .press-hero (see script below), then sticks flush under it
     once scrolling would otherwise carry it out of view — same
     "appear, then pin" pattern as the icon rail elsewhere. Its own
     background is a fade from the nav's solid color down to transparent,
     so it reads as one continuous piece with the nav rather than a
     second floating bar — the pills sit inside that fade rather than
     needing a hard-edged bar of their own. */
  .press-subnav {
    position: sticky;
    top: var(--nav-height);
    z-index: 30;
    padding-top: 1rem;
    padding-bottom: 2.5rem;
    background: linear-gradient(
      to bottom,
      var(--color-background) 0%,
      var(--color-background) 40%,
      transparent 100%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .press-subnav.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .press-subnav__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .press-subnav__tab {
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    background: var(--color-muted);
    color: var(--color-foreground);
    text-decoration: none;
    font-family: "Donau Neue", system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .press-subnav__tab:hover {
    background: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  /* Scrolling a short page on a phone is easy enough without a jump-nav,
     and the pill row doesn't have room to breathe at that width anyway. */
  @media (max-width: 640px) {
    .press-subnav {
      display: none;
    }
  }
</style>

<script>
  function initPressSubnav() {
    const subnav = document.querySelector<HTMLElement>("#press-subnav");
    const hero = document.querySelector<HTMLElement>(".press-hero");
    if (!subnav || !hero) return;

    function absoluteTop(el: HTMLElement) {
      return el.getBoundingClientRect().top + window.scrollY;
    }

    function update() {
      const threshold = absoluteTop(hero!) + hero!.offsetHeight * 0.5;
      subnav!.classList.toggle("is-visible", window.scrollY > threshold);
    }

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  initPressSubnav();
  document.addEventListener("astro:after-swap", initPressSubnav);
</script>
