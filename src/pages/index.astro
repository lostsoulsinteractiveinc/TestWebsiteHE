---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getAssetPath } from "@/utils/withBase";

const keyFeatures = [
  {
    label: "Story",
    body: "Our story is unlike any other. With 100 years of history, we're presenting the player with only a sliver of what has happened in this tale of generational torment and pain. Everyone in the game has their own retelling of what happened in this small town, but the only one who truly knows it is the man who hunts you.",
  },
  {
    label: "Mechanic",
    body: `Hotel Espir's main mechanic is sound. How you use it is up to you. If you don't learn how to think with your ears, you might as well consider yourself dead. Mechanics like throwing items to distract, holding your breath, and using our bespoke item aptly named the "banishment box" take the typical stealth mechanics and turn it up a notch to really solidify the fact that one wrong breath can get you killed.`,
  },
  {
    label: "Style",
    body: "Paying homage to classics in the investigative horror genre, we lean towards the art deco style similar to the original BioShock. In both our marketing and in-game art, as well as the design aesthetic of Hotel Espir as a whole, the remnants of Frank Lloyd Wright's classic design cues are readily apparent.",
  },
];

const quickFacts = [
  { label: "Title", value: "Hotel Espir" },
  { label: "Genre", value: "Horror" },
  { label: "Developer", value: "Lost Souls Interactive (LSI)" },
  { label: "Platform", value: "Steam, Windows" },
  { label: "Price", value: "USD $14.99 · CAD $16.99 · EUR €14.99 · AUD $19.99" },
];

const mediaSlots = [
  { label: "Logo", image: "img/logo.png" },
  { label: "Poster", image: "img/header-image.png" },
  { label: "Game screenshots (4K, Photo Mode)" },
  { label: "Videos (YouTube, no spoilers)" },
];
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout my-1">
    <div class="border-border h-80 w-full overflow-hidden rounded-lg border sm:h-96">
      <img
        src={getAssetPath("img/header-image.png")}
        alt="Hotel Espir key art"
        class="h-full w-full object-cover"
      />
    </div>

    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hotel Espir
      </h1>
      <p class="italic">
        Trapped overnight in a grand Alabama hotel built on plantation soil,
        you must outsmart the echo of a century-old killer. Use sound,
        stealth, and your instincts to survive the night and uncover the
        secret beneath Hotel Espir.
      </p>
    </section>

    <section id="description" class="border-border border-b pt-8 pb-6">
      <p>
        In the 1940s, the final stretch of Charles Lemek's journey should be
        driving home to his loving wife. As he pulls into the Hotel Espir for
        the night, something unknown is already coming alive. With guests
        culminating in the lobby to experience the event, no one is aware yet
        how their town will be changed forever, again.
      </p>
      <p class="mt-4">
        In Hotel Espir, you're put face to face with a murder from 100 years
        ago, forced to learn this small town's history to escape, or die
        trying.
      </p>
    </section>

    <div id="press-kit" class="scroll-mt-24">
      <section id="key-features" class="border-border border-b pt-12 pb-6">
        <h2 class="text-2xl font-semibold tracking-wide">Key Features</h2>
        <dl class="mt-4 space-y-6">
          {
            keyFeatures.map(({ label, body }) => (
              <div>
                <dt class="text-accent font-semibold">{label}</dt>
                <dd class="mt-1">{body}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="quick-facts" class="border-border border-b pt-12 pb-6">
        <h2 class="text-2xl font-semibold tracking-wide">Quick Facts</h2>
        <dl class="mt-4 space-y-2">
          {
            quickFacts.map(({ label, value }) => (
              <div class="flex flex-col sm:flex-row sm:gap-2">
                <dt class="font-semibold sm:w-28 sm:shrink-0">{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="media" class="border-border border-b pt-12 pb-6">
        <h2 class="text-2xl font-semibold tracking-wide">Media</h2>
        <p class="mt-2 text-sm italic">Assets coming soon.</p>
        <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            mediaSlots.map(({ label, image }) => (
              <li class="border-border bg-muted flex h-32 items-center justify-center rounded-lg border p-4 text-center">
                {image ? (
                  <img
                    src={getAssetPath(image)}
                    alt={label}
                    class="max-h-full max-w-full object-contain"
                  />
                ) : (
                  <span class="text-foreground/50 text-sm">{label}</span>
                )}
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <section id="contact" class="pt-12 pb-6 text-center">
      <h2 class="text-2xl font-semibold tracking-wide">Contact</h2>
      <p class="mt-4">
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="mailto:contact@lostsoulsinteractive.com"
        >
          contact@lostsoulsinteractive.com
        </LinkButton>
      </p>
    </section>
  </main>
  <Footer />
</Layout>
