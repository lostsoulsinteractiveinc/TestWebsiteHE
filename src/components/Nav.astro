---
import logoMark from "@/assets/img/logo-mark.png";
import SocialIcons from "./SocialIcons.astro";
import { navLinks } from "@/data/navLinks";

// Route paths match each file's location under src/pages/ (e.g.
// src/pages/press.astro → /press), not the src/pages/ path itself.
// Prefixed with BASE_URL so links still resolve once deployed under
// the /TestWebsiteHE/ subpath — a hardcoded "/news" would 404 there.
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const homeHref = `${base}/`;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="site-nav">
  <div class="site-nav__bar">
    <a href={homeHref} class="site-nav__logo" aria-label="Hotel Espir home">
      <img
        src={logoMark.src}
        width={logoMark.width}
        height={logoMark.height}
        alt=""
      />
    </a>

    <button
      id="nav-toggle"
      class="site-nav__toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span class="site-nav__toggle-bar"></span>
      <span class="site-nav__toggle-bar"></span>
      <span class="site-nav__toggle-bar"></span>
    </button>

    <ul id="nav-links" class="site-nav__links">
      {
        navLinks.map(({ label, path }) => {
          const href = `${base}${path}`;
          return (
            <li>
              <a href={href} aria-current={currentPath === href ? "page" : undefined}>
                {label}
              </a>
            </li>
          );
        })
      }

      <li class="site-nav__divider" aria-hidden="true">|</li>

      <li class="site-nav__social-item">
        <SocialIcons size="1.25rem" limit={5} />
      </li>
    </ul>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    transition: background-color 0.3s ease;
  }

  /* Applied once scrolled 50% through the hero — see the script below.
     On pages with no hero, this never gets added and nav stays transparent. */
  .site-nav.is-scrolled {
    background-color: var(--color-background);
  }

  .site-nav__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--nav-height);
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .site-nav__logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-nav__logo img {
    height: 2.25rem;
    width: auto;
    display: block;
  }

  .site-nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .site-nav__toggle-bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-foreground);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .site-nav__toggle.is-active .site-nav__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-nav__toggle.is-active .site-nav__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-nav__toggle.is-active .site-nav__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__links a {
    color: var(--color-foreground);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: "Donau Neue", system-ui, -apple-system, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .site-nav__links a:hover,
  .site-nav__links a[aria-current="page"] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .site-nav__divider {
    color: var(--color-foreground);
    opacity: 0.4;
    font-family: "Donau Neue", system-ui, -apple-system, sans-serif;
    font-size: 1.125rem;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .site-nav__toggle {
      display: flex;
    }

    .site-nav__links {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      display: none;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1rem clamp(1.25rem, 4vw, 3rem) 1.75rem;
      /* Solid, not transparent: an open dropdown sits on top of scrolling
         page content, so it needs its own backing or the two overlap and
         both become unreadable. Matches the page background exactly so it
         still reads as "no navbar chrome", just an opaque page underneath. */
      background: var(--color-background);
    }

    .site-nav__links.is-open {
      display: flex;
    }

    /* A horizontal "|" reads oddly in a stacked list — drop it and let
       the social row sit as its own line instead. */
    .site-nav__divider {
      display: none;
    }

    .site-nav__social-item {
      margin-top: 0.5rem;
    }
  }
</style>

<script>
  function initNavToggle() {
    const toggle = document.querySelector<HTMLButtonElement>("#nav-toggle");
    const links = document.querySelector<HTMLUListElement>("#nav-links");
    if (!toggle || !links) return;

    toggle.addEventListener("click", () => {
      const isOpen = links.classList.toggle("is-open");
      toggle.classList.toggle("is-active", isOpen);
      toggle.setAttribute("aria-expanded", String(isOpen));
    });
  }

  initNavToggle();
  document.addEventListener("astro:after-swap", initNavToggle);

  function initNavScrollBg() {
    const nav = document.querySelector<HTMLElement>(".site-nav");
    if (!nav) return;

    // Pages with a hero (the homepage) measure against it. Pages with a
    // full-page TorchBackground instead (News) fall back to the first
    // content section, so the nav still starts transparent over that
    // background and turns solid once you scroll into the actual content.
    // Plain pages with neither (About/Press) have nothing to be
    // transparent over, so they just stay solid — checking for
    // TorchBackground specifically (rather than any ".section") keeps
    // that plain-page behavior intact.
    const hero = document.querySelector<HTMLElement>(".hero");
    const hasTorchBackground = document.querySelector<HTMLElement>(".torch-bg");
    const referenceEl =
      hero ?? (hasTorchBackground ? document.querySelector<HTMLElement>(".section") : null);

    if (!referenceEl) {
      nav.classList.add("is-scrolled");
      return;
    }

    function updateNavBg() {
      const threshold = referenceEl!.offsetHeight * 0.5;
      nav!.classList.toggle("is-scrolled", window.scrollY > threshold);
    }

    updateNavBg();
    window.addEventListener("scroll", updateNavBg, { passive: true });
    window.addEventListener("resize", updateNavBg);
  }

  initNavScrollBg();
  document.addEventListener("astro:after-swap", initNavScrollBg);
</script>
