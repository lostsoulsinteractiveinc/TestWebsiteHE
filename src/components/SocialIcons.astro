---
import { socials } from "@/data/socials";

type Props = {
  size?: string;
  class?: string;
  limit?: number;
};

const { size = "1.25rem", class: className, limit } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const visibleSocials = limit ? socials.slice(0, limit) : socials;
---

<div class:list={["social-icons", className]} style={`--icon-size: ${size}`}>
  {
    visibleSocials.map(({ label, href, icon }) => (
      <a href={href} aria-label={label} title={label} target="_blank" rel="noopener noreferrer">
        <span
          class="social-icons__icon"
          style={`--icon: url(${base}/img/socials/${icon})`}
        />
      </a>
    ))
  }
</div>

<style>
  .social-icons {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .social-icons__icon {
    display: block;
    width: var(--icon-size);
    height: var(--icon-size);
    background-color: var(--color-foreground);
    mask-image: var(--icon);
    -webkit-mask-image: var(--icon);
    mask-size: contain;
    -webkit-mask-size: contain;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-position: center;
    transition: background-color 0.2s ease;
  }

  .social-icons a:hover .social-icons__icon {
    background-color: var(--color-accent);
  }
</style>
