---
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const lightSrc = `${base}/img/background.jpg`;
const darkSrc = `${base}/img/backgrounddark.png`;
---

<section class="torch" id="torch-reveal">
  <img class="torch__layer torch__layer--dark" src={darkSrc} alt="" />
  <img class="torch__layer torch__layer--light" src={lightSrc} alt="" />
</section>

<style>
  .torch {
    position: relative;
    width: 100%;
    height: min(90vh, 60rem);
    min-height: 24rem;
    overflow: hidden;
    /* Mouse position (px, relative to this element) and the beam's
       current radius — 0 until hovered, so only the dark layer shows
       by default. Both driven by the script below. */
    --torch-x: 50%;
    --torch-y: 50%;
    --torch-radius: 0px;
  }

  .torch__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .torch__layer--dark {
    z-index: 1;
  }

  .torch__layer--light {
    z-index: 2;
    /* A circle of "black" (opaque) around the cursor lets the light
       image show through; it fades to transparent outside that circle,
       revealing the dark image underneath instead. */
    -webkit-mask-image: radial-gradient(
      circle at var(--torch-x) var(--torch-y),
      black 0,
      black var(--torch-radius),
      transparent calc(var(--torch-radius) + 60px)
    );
    mask-image: radial-gradient(
      circle at var(--torch-x) var(--torch-y),
      black 0,
      black var(--torch-radius),
      transparent calc(var(--torch-radius) + 60px)
    );
  }
</style>

<script>
  function initTorch() {
    const torch = document.querySelector<HTMLElement>("#torch-reveal");
    if (!torch) return;

    const BEAM_RADIUS = "70px";

    function moveTorch(event: MouseEvent) {
      const rect = torch!.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      torch!.style.setProperty("--torch-x", `${x}px`);
      torch!.style.setProperty("--torch-y", `${y}px`);
      torch!.style.setProperty("--torch-radius", BEAM_RADIUS);
    }

    function hideTorch() {
      torch!.style.setProperty("--torch-radius", "0px");
    }

    torch.addEventListener("mousemove", moveTorch);
    torch.addEventListener("mouseleave", hideTorch);
  }

  initTorch();
  document.addEventListener("astro:after-swap", initTorch);
</script>
